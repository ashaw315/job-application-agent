# Job Application Agent - Runner CLI Configuration

# Web app base URL (required)
# Points to the running web application API.
# For local development:
RUNNER_APP_BASE_URL="http://localhost:3000"

# Runner API key (required)
# Must match RUNNER_API_KEY in web app configuration.
# This authenticates the runner when fetching packets and posting reports.
RUNNER_API_KEY="your-secret-key-change-me"

# Artifact directory (optional, defaults to ./artifacts)
# Where screenshots, HTML snapshots, and traces are saved.
RUNNER_ARTIFACT_DIR="./artifacts"

# Headless mode (optional, defaults to true)
# Set to false to see browser automation in action (useful for debugging).
# Options: true, false
RUNNER_HEADLESS="true"

# Post results back to web app (optional, defaults to true)
# When true, runner automatically posts RunnerReport to /api/runner/runs.
# When false, report is only output to stdout.
RUNNER_POST_RESULTS="true"
