# Job Application Agent - Web App Configuration

# Database connection string (required)
# For local development with PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/jobagent?schema=public"
# For production with Supabase:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobagent?schema=public"

# Redis connection string (optional)
# When present, enables BullMQ queue mode for async job processing.
# When absent, runs in inline mode (synchronous, blocks HTTP requests).
# For local development with Redis:
# REDIS_URL="redis://localhost:6379"
# For production with Upstash Redis:
# REDIS_URL="rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379"
REDIS_URL="redis://localhost:6379"

# OpenAI API key (optional)
# When present, enables LLM-powered cover letter and resume drafting.
# When absent, creates placeholder materials.
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Runner API key (required)
# Shared secret between web app and runner CLI for authentication.
# Use a strong random string. Example: openssl rand -hex 32
RUNNER_API_KEY="your-secret-key-change-me"

# Public app URL (optional, defaults to http://localhost:3000)
# Used for generating runner packet URLs and webhooks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment (optional, defaults to development)
# Options: development, production, test
NODE_ENV="development"