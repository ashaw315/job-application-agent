// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton user profile
model UserProfile {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// Job source metadata (URL, ATS type, etc)
model JobSource {
  id         String   @id @default(uuid())
  url        String
  atsType    String @map("ats_type") // "greenhouse" | "lever" | "generic"
  scrapedAt  DateTime @default(now()) @map("scraped_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  jobPostings JobPosting[]

  @@index([url])
  @@map("job_sources")
}

// Main job posting entity
model JobPosting {
  id          String   @id @default(uuid())
  dedupeKey   String   @unique @map("dedupe_key") // For deduplication
  title       String
  company     String
  location    String?
  salaryMin   Int? @map("salary_min")
  salaryMax   Int? @map("salary_max")
  description String
  status      String   @default("new") // "new" | "needs_attention" | "in_review" | "applied" | "rejected" | "archived"

  sourceKey   String? @map("source_key") // ATS-specific job ID (e.g., greenhouse job ID)
  applyUrl    String? @map("apply_url") // Direct application URL

  jobSourceId String @map("job_source_id")
  jobSource   JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  fitScore              FitScore?
  materialPackets       MaterialPacket[]
  statusEvents          StatusEvent[]
  followUpSuggestions   FollowUpSuggestion[]
  runnerRuns            RunnerRun[]

  @@index([status])
  @@index([company])
  @@index([createdAt])
  @@map("job_postings")
}

// 1:1 fit score for each job posting
model FitScore {
  id            String   @id @default(uuid())
  jobPostingId  String   @unique @map("job_posting_id")
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  score         Float // 0-100
  reasoning     String

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("fit_scores")
}

// Resume knowledge base bullets
model KbBullet {
  id        String   @id @default(uuid())
  text      String
  tags      String // JSON array stored as string

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("kb_bullets")
}

// Optional: Resume knowledge base projects
model KbProject {
  id          String   @id @default(uuid())
  name        String
  description String
  technologies String // JSON array stored as string

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("kb_projects")
}

// Optional: STAR stories for behavioral questions
model KbStarStory {
  id          String   @id @default(uuid())
  title       String
  situation   String
  task        String
  action      String
  result      String
  tags        String // JSON array stored as string

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("kb_star_stories")
}

// Generated application materials packet
model MaterialPacket {
  id                String   @id @default(uuid())
  jobPostingId      String @map("job_posting_id")
  jobPosting        JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  resumeVariantText String @map("resume_variant_text")
  coverLetterText   String? @map("cover_letter_text")
  customAnswers     String? @map("custom_answers") // JSON stored as string
  metadata          String? // JSON stored as string (selectedKbBulletIds, jobKeywords, etc)

  generatedAt       DateTime @default(now()) @map("generated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  versions          MaterialVersion[]

  @@index([jobPostingId])
  @@map("material_packets")
}

// Version history for material packets
model MaterialVersion {
  id                String   @id @default(uuid())
  materialPacketId  String @map("material_packet_id")
  materialPacket    MaterialPacket @relation(fields: [materialPacketId], references: [id], onDelete: Cascade)

  version           Int
  stage             String   // "generated" | "edited" | "approved"
  type              String   // "cover_letter" | "resume_variant"
  content           String   // JSON stored as string

  // Optional reference to the version this edit is based on (for edited versions)
  diffBaseVersionId String? @map("diff_base_version_id")
  diffBaseVersion   MaterialVersion? @relation("EditBase", fields: [diffBaseVersionId], references: [id], onDelete: SetNull)
  edits             MaterialVersion[] @relation("EditBase")

  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([materialPacketId, version])
  @@index([materialPacketId])
  @@index([stage])
  @@index([type])
  @@index([diffBaseVersionId])
  @@map("material_versions")
}

// Status change events for job postings
model StatusEvent {
  id            String   @id @default(uuid())
  jobPostingId  String @map("job_posting_id")
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  fromStatus    String? @map("from_status")
  toStatus      String @map("to_status")
  actor         String?  // "user" | "runner" | "system"
  notes         String?

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([jobPostingId])
  @@index([createdAt])
  @@map("status_events")
}

// Follow-up suggestions
model FollowUpSuggestion {
  id            String   @id @default(uuid())
  jobPostingId  String @map("job_posting_id")
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  text          String
  suggestedAt   DateTime @default(now()) @map("suggested_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  emailDrafts   FollowUpEmailDraft[]

  @@index([jobPostingId])
  @@map("follow_up_suggestions")
}

// Follow-up email drafts
model FollowUpEmailDraft {
  id                    String   @id @default(uuid())
  followUpSuggestionId  String @map("follow_up_suggestion_id")
  followUpSuggestion    FollowUpSuggestion @relation(fields: [followUpSuggestionId], references: [id], onDelete: Cascade)

  subject               String
  body                  String

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([followUpSuggestionId])
  @@map("follow_up_email_drafts")
}

// Runner automation execution records
model RunnerRun {
  id            String   @id @default(uuid())
  jobPostingId  String @map("job_posting_id")
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  status        String   // "success" | "stopped_before_submit" | "failed" | "critical_error"
  errors        String   @default("[]") // JSON array of error messages
  warnings      String   @default("[]") // JSON array of warning messages
  stoppedReason String? @map("stopped_reason")
  appliedAt     DateTime? @map("applied_at")

  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  artifacts     RunnerArtifact[]

  @@index([jobPostingId])
  @@index([status])
  @@index([startedAt])
  @@map("runner_runs")
}

// Artifacts produced by runner (screenshots, HTML, etc)
model RunnerArtifact {
  id            String   @id @default(uuid())
  runnerRunId   String @map("runner_run_id")
  runnerRun     RunnerRun @relation(fields: [runnerRunId], references: [id], onDelete: Cascade)

  artifactType  String @map("artifact_type") // "screenshot" | "html" | "pdf" | "json"
  filePath      String? @map("file_path")
  content       String?
  description   String?

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([runnerRunId])
  @@index([artifactType])
  @@map("runner_artifacts")
}
